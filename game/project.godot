; 引擎配置。移动端 120fps 相关设置集中在 [display] [rendering] [physics]
config_version=5

[application]

config/name="APEX DRIFT"
config/version="1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
run/max_fps=0
run/low_processor_mode=false
run/delta_smoothing=true

[audio]

driver/mix_rate=44100
general/ios/session_category=1

[display]

window/size/viewport_width=1334
window/size/viewport_height=616
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/ios/allow_high_refresh_rate=true
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true
window/ios/suppress_ui_gesture=true
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false
sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=false
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8
3d/solver/solver_iterations=6

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size.mobile=0
lights_and_shadows/use_physical_light_units=false
reflections/sky_reflections/roughness_layers=6
reflections/sky_reflections/ggx_samples=16
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=1
shading/overrides/force_vertex_shading=false
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.04, 1)
mesh_lod/lod_change/threshold_pixels=2.0
occlusion_culling/use_occlusion_culling=false
global_illumination/gi/use_half_resolution=true
